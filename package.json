{
  "name": "@lsby/playground-ts-service",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lsby/playground-ts-service.git"
  },
  "type": "module",
  "main": "./dist/src/electron.js",
  "browser": {
    "./src/global/db/db-dialect.ts": "./src/web/mock/db-dialect-mock.ts",
    "./src/global/env-provider.ts": "./src/web/mock/env-provider-mock.ts"
  },
  "bin": {
    "lsby-playground-ts-service": "dist/src/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "_build:all": "npm run _clean:all && npm run _build:service && npm run _build:web && tsx scripts/post-build/index.ts",
    "_build:service": "tsc && tsc-alias -f",
    "_build:web": "npm run _clean:web && parcel build --no-autoinstall --no-cache --no-source-maps src/web/page/**/*.html --dist-dir dist/src/web",
    "_build:web-test": "npm run _clean:web-test && parcel build --no-autoinstall --no-cache --no-source-maps src/web/page/**/*.html --dist-dir test-outputs/web-test",
    "_build:web:no-scope-hoist": "npm run _clean:web && parcel build --no-autoinstall --no-cache --no-source-maps --no-scope-hoist src/web/page/**/*.html --dist-dir dist/src/web",
    "_build:web:pure-frontend": "npm run _clean:web && parcel build --no-autoinstall --no-cache --no-source-maps --no-scope-hoist src/web/page/**/*.html --dist-dir dist/src/web",
    "_check:all": "npm run _check:format && npm run _check:lint && npm run _check:type",
    "_check:format": "prettier --write .",
    "_check:lint": "eslint . --fix",
    "_check:type": "tsc --noEmit",
    "_clean:all": "tsx scripts/clean/clean-all.ts",
    "_clean:web": "tsx scripts/clean/clean-web.ts",
    "_clean:web-test": "tsx scripts/clean/clean-web-test.ts",
    "_gen:all": "npm run _gen:api:list && npm run _gen:api:type && npm run _gen:web:index && npm run _gen:web:local-api-list && npm run _gen:web:local-schema && npm run _gen:meta-info",
    "_gen:api:list": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* lsby-net-core-gen-api-list ./tsconfig.json ./src/interface ./src/interface/interface-list.ts",
    "_gen:api:type": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* lsby-net-core-gen-api-type ./tsconfig.json ./src/interface ./src/types/interface-type.ts",
    "_gen:meta-info": "tsx scripts/gen/gen-meta-info.ts",
    "_gen:web:index": "tsx scripts/gen/gen-web-index.ts",
    "_gen:web:local-api-list": "tsx scripts/gen/gen-local-api-list.ts",
    "_gen:web:local-schema": "tsx scripts/gen/gen-local-schema.ts",
    "capacitor:add:android": "cap add android",
    "capacitor:init": "cap init",
    "capacitor:open:android": "cap open android",
    "capacitor:sync:android": "cap sync android",
    "db:push:dev:web": "dotenv -e ./.env/.env.development.web -- prisma migrate dev && dotenv -e ./.env/.env.development.web -- prisma generate",
    "db:push:prod:electron": "tsx scripts/db/push-prod.ts ./.env/.env.production.electron",
    "db:push:prod:sea": "tsx scripts/db/push-prod.ts ./.env/.env.production.sea",
    "db:push:prod:web": "tsx scripts/db/push-prod.ts ./.env/.env.production.web",
    "db:push:test:web": "tsx scripts/db/push-prod.ts ./.env/.env.test.web",
    "prepare": "husky",
    "public:docker:local": "tsx scripts/public/release-docker-local.ts",
    "public:docker:remote": "tsx scripts/public/release-docker-remote.ts",
    "public:electron": "npm run db:push:prod:electron && dotenv -e ./.env/.env.production.electron -- npm run _check:all && dotenv -e ./.env/.env.production.electron -- npm run _build:all && tsx scripts/public/release-electron.ts",
    "public:npm": "npm publish --access public",
    "public:sea": "npm run db:push:prod:sea && dotenv -e ./.env/.env.production.sea -- npm run _check:all && dotenv -e ./.env/.env.production.sea -- npm run _build:all && tsx scripts/public/release-sea.ts",
    "public:web:pure-frontend": "dotenv -e ./.env/.env.production.pure-frontend -- npm run _build:web:pure-frontend && tsx scripts/public/release-pure-frontend.ts",
    "release": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* npm run _gen:all && npm run _check:all && bumpp --no-commit --no-tag --no-push && tsx scripts/release/release.ts",
    "run:electron:dev": "node -e \"if (process.platform === 'win32') { try { require('child_process').execSync('chcp 65001', { stdio: 'inherit' }); } catch {} }\" && cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* ENV_FILE_PATH=./.env/.env.development.electron nodemon --watch src --ext ts --ignore src/types/**/* --ignore src/interface/interface-list.ts --ignore src/web/**/* --exec \"electron -r tsx src/electron.ts\"",
    "run:electron:prod": "node -e \"if (process.platform === 'win32') { try { require('child_process').execSync('chcp 65001', { stdio: 'inherit' }); } catch {} }\" && cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* ENV_FILE_PATH=./.env/.env.production.electron electron -r tsx dist/src/electron.js",
    "run:pure-frontend:dev": "cross-env ENV_FILE_PATH=./.env/.env.development.pure-frontend tsx scripts/web/web-run.ts",
    "run:service:dev": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* ENV_FILE_PATH=./.env/.env.development.web tsx watch --exclude ./src/types/**/* --exclude ./src/interface/interface-list.ts --inspect ./src/server.ts",
    "run:service:prod": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* ENV_FILE_PATH=./.env/.env.production.web node ./dist/src/server.js",
    "run:service:test": "cross-env DEBUG=@lsby:*,@lsby:playground-ts-service:* ENV_FILE_PATH=./.env/.env.test.web tsx ./src/server.ts",
    "run:web:dev": "cross-env ENV_FILE_PATH=./.env/.env.development.web tsx scripts/web/web-run.ts",
    "setup:ports": "tsx scripts/setup/init-ports.ts",
    "setup:rename": "tsx scripts/setup/rename-project.ts",
    "test:e2e": "cross-env DEBUG=@lsby:*,-*:trace ENV_FILE_PATH=./.env/.env.test.web tsx scripts/test/run-e2e.ts",
    "test:integration": "cross-env DEBUG=@lsby:*,-*:trace ENV_FILE_PATH=./.env/.env.test.web tsx scripts/test/run-integration.ts",
    "test:unit": "cross-env DEBUG=@lsby:*,-*:trace ENV_FILE_PATH=./.env/.env.test.web tsx scripts/test/run-test.ts",
    "watch:check:lint": "tsx scripts/watch/watch.ts src scripts \"eslint .\"",
    "watch:check:type": "tsc --noEmit -w",
    "watch:gen:api:list": "cross-env DEBUG=@lsby:* tsx scripts/watch/watch.ts ./src/interface/ \"npm run _gen:api:list\"",
    "watch:gen:api:type": "cross-env DEBUG=@lsby:* tsx scripts/watch/watch.ts ./src/interface/ \"npm run _gen:api:type\"",
    "watch:gen:web:index": "cross-env DEBUG=@lsby:* tsx scripts/watch/watch.ts ./src/web/components/ \"npm run _gen:web:index\"",
    "watch:gen:web:local-api-list": "cross-env DEBUG=@lsby:* tsx scripts/watch/watch.ts ./src/interface/ \"npm run _gen:web:local-api-list\"",
    "watch:gen:web:local-schema": "cross-env DEBUG=@lsby:* tsx scripts/watch/watch.ts ./prisma/ \"npm run _gen:web:local-schema\""
  },
  "lint-staged": {
    "*.{ts,js,json,css,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.1",
    "@capacitor/dialog": "^7.0.2",
    "@lsby/net-core": "^0.14.19",
    "@lsby/net-core-jwt": "^0.5.4",
    "@lsby/net-core-kysely": "^0.6.0",
    "@lsby/ts-env": "^0.0.14",
    "@lsby/ts-fp-data": "^0.2.7",
    "@lsby/ts-http-extend": "^0.3.4",
    "@lsby/ts-kysely": "^0.2.10",
    "@lsby/ts-log": "^0.3.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@subframe7536/sqlite-wasm": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^8.0.0",
    "express": "^5.2.1",
    "kysely": "^0.29.4",
    "kysely-wasm": "^1.2.1",
    "kysely-wasqlite-worker": "^2.0.1",
    "node-schedule": "^2.1.1",
    "node-sqlite3-wasm": "^0.8.52",
    "open": "^11.0.0",
    "prisma": "^7.2.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@lsby/eslint-config": "^0.5.6",
    "@lsby/eslint-plugin": "^0.2.1",
    "@parcel/config-default": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@playwright/test": "^1.40.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "@types/node-schedule": "^2.1.8",
    "@types/stream-to-blob": "^2.0.0",
    "@vitest/coverage-v8": "^2.1.1",
    "archiver": "^7.0.1",
    "bumpp": "^10.3.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "husky": "^9.1.7",
    "inquirer": "^12.9.4",
    "lint-staged": "^15.5.0",
    "node-ssh": "^13.2.1",
    "node-watch": "^0.7.4",
    "nodemon": "^3.1.11",
    "open-cli": "^8.0.0",
    "parcel": "^2.16.4",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "prisma-kysely": "^1.8.0",
    "process": "^0.11.10",
    "stream-to-blob": "^2.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "util": "^0.12.5",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "patchedDependencies": {
      "@sqlite.org/sqlite-wasm@3.53.0-build1": "patches/@sqlite.org__sqlite-wasm@3.53.0-build1.patch",
      "kysely-generic-sqlite@1.2.1": "patches/kysely-generic-sqlite@1.2.1.patch"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "alias": {
    "express": "./src/web/mock/express-mock.ts",
    "multer": "./src/web/mock/unsupported-mock.ts",
    "ws": "./src/web/mock/unsupported-mock.ts",
    "dotenv": "./src/web/mock/unsupported-mock.ts",
    "stream": "./src/web/mock/unsupported-mock.ts",
    "stream/promises": "./src/web/mock/unsupported-mock.ts",
    "path": "./src/web/mock/unsupported-mock.ts",
    "os": "./src/web/mock/unsupported-mock.ts",
    "events": "./src/web/mock/unsupported-mock.ts",
    "string_decoder": "./src/web/mock/unsupported-mock.ts",
    "buffer": "./src/web/mock/unsupported-mock.ts",
    "util": "./src/web/mock/util-mock.ts",
    "node:util": "./src/web/mock/util-mock.ts",
    "crc": "./src/web/mock/unsupported-mock.ts",
    "crypto": "./src/web/mock/crypto-mock.ts"
  },
  "build": {
    "npmRebuild": false,
    "appId": "lsby.playground.ts.service",
    "productName": "lsby-playground-ts-service",
    "asar": false,
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    }
  },
  "targets": {
    "main": false
  }
}
