{
  "name": "@lsby/playground-ts-app",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lsby/playground-ts-app.git"
  },
  "type": "module",
  "main": "./dist/src/electron.js",
  "browser": {
    "./src/global/db/db-dialect.ts": "./src/web/mock/db-dialect-mock.ts",
    "./src/global/env-provider.ts": "./src/web/mock/env-provider-mock.ts"
  },
  "bin": {
    "lsby-playground-ts-app": "dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:all": "tsx scripts/task/index.ts build:all",
    "check": "tsx scripts/task/index.ts check",
    "dev:electron": "tsx scripts/task/index.ts dev:electron",
    "dev:pure-frontend": "tsx scripts/task/index.ts dev:pure-frontend",
    "dev:web": "tsx scripts/task/index.ts dev:web",
    "fix": "tsx scripts/task/index.ts fix",
    "generate": "tsx scripts/task/index.ts generate",
    "preinstall": "node scripts/setup/preinstall.mjs",
    "postinstall": "node scripts/setup/postinstall.mjs",
    "prepare": "husky",
    "setup": "tsx scripts/task/index.ts setup",
    "setup:init": "tsx scripts/task/index.ts setup:init",
    "task": "tsx scripts/task/index.ts",
    "test:e2e": "tsx scripts/task/index.ts test:e2e",
    "test:e2e:all": "tsx scripts/task/index.ts test:e2e:all",
    "test:requirement": "tsx scripts/task/index.ts test:requirement",
    "test:requirement:all": "tsx scripts/task/index.ts test:requirement:all",
    "test:unit": "tsx scripts/task/index.ts test:unit",
    "test:unit:all": "tsx scripts/task/index.ts test:unit:all"
  },
  "lint-staged": {
    "*.{ts,js,json,css,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.1",
    "@capacitor/dialog": "^7.0.2",
    "@lsby/net-core": "^0.14.22",
    "@lsby/net-core-jwt": "^0.5.4",
    "@lsby/net-core-kysely": "^0.6.0",
    "@lsby/ts-env": "^0.0.14",
    "@lsby/ts-fp-data": "^0.2.7",
    "@lsby/ts-http-extend": "^0.3.4",
    "@lsby/ts-kysely": "^0.2.10",
    "@lsby/ts-log": "^0.3.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@subframe7536/sqlite-wasm": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^8.0.0",
    "express": "^5.2.1",
    "kysely": "^0.29.4",
    "kysely-wasm": "^1.2.1",
    "kysely-wasqlite-worker": "^2.0.1",
    "node-schedule": "^2.1.1",
    "node-sqlite3-wasm": "^0.8.52",
    "open": "^11.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@lsby/eslint-config": "^0.5.6",
    "@lsby/eslint-plugin": "^0.2.1",
    "@parcel/config-default": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@playwright/test": "^1.40.0",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "@types/node-schedule": "^2.1.8",
    "@types/stream-to-blob": "^2.0.0",
    "@vitest/coverage-v8": "^2.1.1",
    "archiver": "^7.0.1",
    "bumpp": "^10.3.1",
    "cross-spawn": "^7.0.6",
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "husky": "^9.1.7",
    "inquirer": "^12.9.4",
    "lint-staged": "^15.5.0",
    "node-ssh": "^13.2.1",
    "node-watch": "^0.7.4",
    "nodemon": "^3.1.11",
    "open-cli": "^8.0.0",
    "parcel": "^2.16.4",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "prisma": "7.2.0",
    "prisma-kysely": "^1.8.0",
    "process": "^0.11.10",
    "stream-to-blob": "^2.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "util": "^0.12.5",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "patchedDependencies": {
      "@sqlite.org/sqlite-wasm@3.53.0-build1": "patches/@sqlite.org__sqlite-wasm@3.53.0-build1.patch",
      "kysely-generic-sqlite@1.2.1": "patches/kysely-generic-sqlite@1.2.1.patch"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "alias": {
    "express": "./src/web/mock/express-mock.ts",
    "multer": "./src/web/mock/unsupported-mock.ts",
    "ws": "./src/web/mock/unsupported-mock.ts",
    "dotenv": "./src/web/mock/unsupported-mock.ts",
    "stream": "./src/web/mock/unsupported-mock.ts",
    "stream/promises": "./src/web/mock/unsupported-mock.ts",
    "path": "./src/web/mock/unsupported-mock.ts",
    "os": "./src/web/mock/unsupported-mock.ts",
    "events": "./src/web/mock/unsupported-mock.ts",
    "string_decoder": "./src/web/mock/unsupported-mock.ts",
    "buffer": "./src/web/mock/unsupported-mock.ts",
    "util": "./src/web/mock/util-mock.ts",
    "node:util": "./src/web/mock/util-mock.ts",
    "crc": "./src/web/mock/unsupported-mock.ts",
    "crypto": "./src/web/mock/crypto-mock.ts"
  },
  "build": {
    "npmRebuild": false,
    "appId": "lsby.playground.ts.app",
    "productName": "lsby-playground-ts-app",
    "asar": false,
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    }
  },
  "targets": {
    "main": false
  }
}
