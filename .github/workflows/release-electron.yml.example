name: 发布 Electron 完整便携包

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:
    inputs:
      tag_name:
        description: 'Release 标签名 (例如 v1.0.0，留空则自动根据 package.json 版本生成)'
        required: false
        type: string

permissions:
  contents: write

jobs:
  release-electron:
    strategy:
      matrix:
        os: [windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 9.5.0

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      # Windows 下使用 hoisted 布局，避免 Electron/Parcel 的深层 pnpm 路径问题。
      - name: 配置依赖布局 (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        run: pnpm config set node-linker hoisted

      - name: 安装依赖
        run: pnpm install --frozen-lockfile

      - name: 创建 Electron 生产环境配置
        env:
          ELECTRON_ENV_FILE: ${{ secrets.ELECTRON_ENV_FILE }}
        run: |
          node -e 'let fs = require("fs"); let value = process.env.ELECTRON_ENV_FILE; if (value === undefined || value === "") throw new Error("缺少仓库 Secret ELECTRON_ENV_FILE"); fs.mkdirSync(".env", { recursive:true }); fs.writeFileSync(".env/.env.production.electron", value.endsWith("\n") ? value : value + "\n")'

      - name: 准备 Electron 数据库 (Windows)
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path db | Out-Null
          New-Item -ItemType File -Force -Path db/prod-electron.db | Out-Null

      - name: 准备 Electron 数据库 (macOS)
        if: runner.os != 'Windows'
        run: |
          mkdir -p db
          touch db/prod-electron.db

      - name: 构建完整便携包
        run: npm run task -- public:electron -- --zip

      - name: 计算 Release 标签 (Windows)
        if: runner.os == 'Windows'
        id: get_tag_win
        shell: pwsh
        run: |
          if ("${{ github.ref }}".StartsWith("refs/tags/")) {
            $tag = "${{ github.ref_name }}"
          } elseif ("${{ inputs.tag_name }}" -ne "") {
            $tag = "${{ inputs.tag_name }}"
          } else {
            $ver = (Get-Content package.json | ConvertFrom-Json).version
            $tag = "v$ver"
          }
          Write-Host "Release Tag: $tag"
          "tag_name=$tag" >> $env:GITHUB_OUTPUT

      - name: 计算 Release 标签 (macOS)
        if: runner.os != 'Windows'
        id: get_tag_unix
        run: |
          if [[ "${{ github.ref }}" == refs/tags/* ]]; then
            tag="${{ github.ref_name }}"
          elif [[ -n "${{ inputs.tag_name }}" ]]; then
            tag="${{ inputs.tag_name }}"
          else
            ver=$(node -p "require('./package.json').version")
            tag="v$ver"
          fi
          echo "Release Tag: $tag"
          echo "tag_name=$tag" >> "$GITHUB_OUTPUT"

      - name: 发布 GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.get_tag_win.outputs.tag_name || steps.get_tag_unix.outputs.tag_name }}
          generate_release_notes: true
          files: release/electron/*.zip
