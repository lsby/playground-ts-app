# 忽略 node_modules，通常不需要把它们打包进镜像
node_modules
npm-debug.log
yarn-error.log

# 忽略日志文件
logs
*.log

# 忽略 Dockerfile 和 .dockerignore 本身
docker
/docker
/docker/**/*
dockerfile
Dockerfile
docker-compose.yml
.dockerignore

# 忽略 Git 相关的文件
.git
.gitignore
.gitattributes

# 忽略本地开发配置文件（如 editorconfig、VSCode 工作区等）
.vscode
.idea
*.swp
*.swo
.env/.env.*
!.env/*.example
deploy/servers.local.json
.setup-state.json

# 忽略操作系统生成的临时文件
.DS_Store
Thumbs.db

# 忽略编译和缓存文件
build
dist
coverage
.cache
.parcel-cache
test-outputs

# 忽略sqlite相关文件
**/*.db
**/*.db-journal
