          "background": {
            "activeOnStart": true,
            "beginsPattern": "^========生成开始========$",
            "endsPattern": "^========生成结束========$"
          }
        }
      ],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_持续生成纯前端本地数据库Schema",
      "type": "shell",
      "command": "npm run task -- watch:local-schema",
      "problemMatcher": [
        {
          "pattern": { "kind": "file", "regexp": "(错误: .*)", "file": 1, "message": 1 },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^========生成开始========$",
            "endsPattern": "^========生成结束========$"
          }
        }
      ],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_运行纯前端",
      "type": "shell",
      "command": "npm run task -- run:pure-frontend:dev",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "运行纯前端开发套件",
      "dependsOrder": "parallel",
      "dependsOn": [
        "_持续类型检查",
        "_持续ESLint检查",
        "_持续生成API接口列表",
        "_持续生成API接口类型",
        "_持续生成web页面入口",
        "_持续生成纯前端本地API列表",
        "_持续生成纯前端本地数据库Schema",
        "_运行纯前端"
      ],
      "problemMatcher": []
    }
  ]
}
