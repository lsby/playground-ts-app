{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "_持续生成API接口列表",
      "type": "shell",
      "command": "npm run task -- watch:api-list",
      "problemMatcher": [
        {
          "pattern": { "kind": "file", "regexp": "(错误: .*)", "file": 1, "message": 1 },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^========生成开始========$",
            "endsPattern": "^========生成结束========$"
          }
        }
      ],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_持续生成API接口类型",
      "type": "shell",
      "command": "npm run task -- watch:api-type",
      "problemMatcher": [
        {
          "pattern": { "kind": "file", "regexp": "(错误: .*)", "file": 1, "message": 1 },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^========生成开始========$",
            "endsPattern": "^========生成结束========$"
          }
        }
      ],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_持续生成web页面入口",
      "type": "shell",
      "command": "npm run task -- watch:web-page-entry",
      "problemMatcher": [
        {
          "pattern": { "kind": "file", "regexp": "(错误: .*)", "file": 1, "message": 1 },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^========生成开始========$",
            "endsPattern": "^========生成结束========$"
          }
        }
      ],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_持续类型检查",
      "type": "shell",
      "command": "npm run task -- watch:type",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_持续ESLint检查",
      "type": "shell",
      "command": "npm run task -- watch:lint",
      "problemMatcher": {
        "owner": "eslint",
        "source": "eslint",
        "pattern": [
          { "regexp": "^(.+)$", "file": 1 },
          {
            "regexp": "^\\s+(\\d+):(\\d+)\\s+(error|warning|info)\\s+(.*?)\\s+(.+)$",
            "line": 1,
            "column": 2,
            "severity": 3,
            "message": 4,
            "code": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^========生成开始========$",
          "endsPattern": "^========生成结束========$"
        }
      },
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_运行web后端",
      "type": "shell",
      "command": "npm run task -- run:service:dev",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_运行前端",
      "type": "shell",
      "command": "npm run task -- run:web:dev",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "_运行electron后端",
      "type": "shell",
      "command": "npm run task -- run:electron:dev",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "运行web开发套件",
      "dependsOrder": "parallel",
      "dependsOn": [
        "_持续类型检查",
        "_持续ESLint检查",
        "_持续生成API接口列表",
        "_持续生成API接口类型",
        "_持续生成web页面入口",
        "_运行web后端",
        "_运行前端"
      ],
      "problemMatcher": []
    },
    {
      "label": "运行electron开发套件",
      "dependsOrder": "parallel",
      "dependsOn": [
        "_持续类型检查",
        "_持续ESLint检查",
        "_持续生成API接口列表",
        "_持续生成API接口类型",
        "_持续生成web页面入口",
        "_运行electron后端",
        "_运行前端"
      ],
      "problemMatcher": []
    },
    {
      "label": "_持续生成纯前端本地API列表",
