NODE_ENV = 'production'
BUILD_TARGET = 'web'
LOCAL_MODE = false
SAMPLE_MODE = false

DEBUG_NAME = "@lsby:playground-ts-app"

# sqlite
DB_TYPE = "sqlite"
DB_PATH = "./db/prod-web.db"
DB_PATH_PRISMA = "file:./${DB_PATH}"
DB_BACKUP_PATH = "./db"
DB_BACKUP_RETENTION_DAYS = 7
DB_BACKUP_PREFIX = "backup_"
DB_BACKUP_AUTO_PREFIX = "auto_"


DEFAULT_SYSTEM_USER = 'admin'
DEFAULT_SYSTEM_PWD = ""

APP_PORT = 30000
WEB_PORT = 30001
WEB_HMR_PORT = 30002
DOCKER_PORT = 80
BACKEND_URL = ""

UPLOAD_MAX_FILE_SIZE = 50

DEFAULT_JWT_SECRET = ""
JWT_EXPIRES_IN = '7d'

BCRYPT_ROUNDS = 10
